{
  "name": "@drivebase/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node --check src/engine-worker.mjs && tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/engine-worker.mjs','dist/engine-worker.mjs')\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "sql.js": "^1.13.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
